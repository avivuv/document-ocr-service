APP_NAME="Doc OCR Service"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:8000

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Stateless ---------------------------------------------------------------
# Service ini tanpa database. Driver di bawah sengaja dipilih agar tidak ada
# satu pun jalur framework yang menyentuh koneksi database.
DB_CONNECTION=null
SESSION_DRIVER=array
CACHE_STORE=file
QUEUE_CONNECTION=sync

# --- OCR Service -------------------------------------------------------------
OCR_API_TOKENS=local-dev:GANTI_DENGAN_TOKEN_BARU

# Isi path absolut bila binary tidak masuk PATH (lumrah di Windows Server / IIS), mis:
#   OCR_BIN_TESSERACT="C:/Program Files/Tesseract-OCR/tesseract.exe"
OCR_BIN_TESSERACT=tesseract
OCR_BIN_PDFTOTEXT=pdftotext
OCR_BIN_PDFTOPPM=pdftoppm
OCR_BIN_MAGICK=magick
OCR_BIN_GS=gswin64c

OCR_ENGINE=tesseract
OCR_MAX_FILE_BYTES=10485760
OCR_MAX_PAGES=5

OCR_TEXT_LAYER_ENABLED=true
OCR_TEXT_LAYER_MIN_ALNUM=200

# Direktori yang boleh dibaca via source.type="path" (pisahkan dengan koma).
# Untuk integrasi CIMB nanti, tambahkan folder attachment intranet & extranet.
OCR_ALLOWED_BASE_PATHS=C:/laragon/www/cimb-ocr/storage/app/inbox

# Halaman upload manual untuk uji coba - WAJIB false di produksi.
OCR_PLAYGROUND_ENABLED=false
